                        <ul class="list-disc list-inside mt-2">
                            <li><span class="font-medium text-orange-500">Food:</span> ₹400</li>
                            <li><span class="font-medium text-blue-500">Transport:</span> ₹350</li>
                            <li><span class="font-medium text-teal-500">Activities:</span> ₹500</li>
                        </ul>
                    </div>
                `);

                const canvas = document.getElementById('spending-chart-canvas');
                const ctx = canvas.getContext('2d');
                const data = {
                    'Food': { value: 400, color: '#f97316' },
                    'Transport': { value: 350, color: '#3b82f6' },
                    'Activities': { value: 500, color: '#14b8a6' }
                };
                const total = Object.values(data).reduce((sum, item) => sum + item.value, 0);
                let currentAngle = 0;

                for (const key in data) {
                    const sliceAngle = (data[key].value / total) * 2 * Math.PI;
                    ctx.beginPath();
                    ctx.arc(canvas.width / 2, canvas.height / 2, Math.min(canvas.width, canvas.height) / 2 - 20, currentAngle, currentAngle + sliceAngle);
                    ctx.lineTo(canvas.width / 2, canvas.height / 2);
                    ctx.fillStyle = data[key].color;
                    ctx.fill();
                    currentAngle += sliceAngle;
                }
            }
            
