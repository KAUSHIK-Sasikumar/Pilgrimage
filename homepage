                        </div>
                    </div>
                    <style>
                        /* For the toggle switch in settings */
                        .switch {
                          position: relative;
                          display: inline-block;
                          width: 40px;
                          height: 20px;
                        }
                        .switch input {
                          opacity: 0;
                          width: 0;
                          height: 0;
                        }
                        .slider {
                          position: absolute;
                          cursor: pointer;
                          top: 0;
                          left: 0;
                          right: 0;
                          bottom: 0;
                          background-color: #ccc;
                          transition: .4s;
                        }
                        .slider:before {
                          position: absolute;
                          content: "";
                          height: 16px;
                          width: 16px;
                          left: 2px;
                          bottom: 2px;
                          background-color: white;
                          transition: .4s;
                        }
                        input:checked + .slider {
                          background-color: #10b981;
                        }
                        input:checked + .slider:before {
                          transform: translateX(20px);
                        }
                        .slider.round {
                          border-radius: 20px;
                        }
                        .slider.round:before {
                          border-radius: 50%;
                        }
                    </style>
                `);

                // Tab switching logic for the profile modal
                const tabs = document.querySelectorAll('.profile-tab-btn');
                const contents = document.querySelectorAll('.profile-tab-content');

                function switchTab(tabId) {
                    tabs.forEach(tab => {
                        tab.classList.remove('text-teal-600', 'border-teal-600');
                        tab.classList.add('text-gray-500', 'border-transparent');
                    });
                    document.querySelector(`[data-tab="${tabId}"]`).classList.add('text-teal-600', 'border-teal-600');
                    document.querySelector(`[data-tab="${tabId}"]`).classList.remove('text-gray-500', 'border-transparent');

                    contents.forEach(content => content.classList.add('hidden'));
                    document.getElementById(`profile-${tabId}-content`).classList.remove('hidden');
                }

                tabs.forEach(tab => {
                    tab.addEventListener('click', (e) => {
                        const tabId = e.target.getAttribute('data-tab');
                        switchTab(tabId);
                    });
                });

                // Set initial active tab
                switchTab('details');
            }

            // --- Event Listeners ---
            document.getElementById('search-btn').addEventListener('click', handleSearch);
            document.getElementById('search-input').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') handleSearch();
            });

            // Top Bar
            const sideDrawer = document.getElementById('side-drawer');
            const drawerOverlay = document.getElementById('drawer-overlay');
            document.getElementById('drawer-toggle').addEventListener('click', () => {
                sideDrawer.classList.add('open');
                drawerOverlay.classList.add('visible');
            });
            document.getElementById('close-drawer').addEventListener('click', () => {
                sideDrawer.classList.remove('open');
                drawerOverlay.classList.remove('visible');
            });
            drawerOverlay.addEventListener('click', () => {
                sideDrawer.classList.remove('open');
                drawerOverlay.classList.remove('visible');
            });
            document.getElementById('profile-btn').addEventListener('click', showProfileModal);
            
            // Section buttons
            document.getElementById('view-all-places-btn').addEventListener('click', () => showPage('explore'));
            document.getElementById('view-deals-btn').addEventListener('click', () => showToast('Viewing all deals.'));
            document.getElementById('more-actions-btn').addEventListener('click', () => showToast('Viewing more actions.'));
            document.getElementById('chat-btn').addEventListener('click', showChatModal);
            
            // Floating Action Button
            document.getElementById('fab-quick-book').addEventListener('click', () => showToast('Quick Book feature coming soon!'));
            
            // Bottom Nav & Drawer Navigation
            const navButtons = document.querySelectorAll('.nav-btn, .drawer-link');
            const pages = document.querySelectorAll('.page-content');
            
            function showPage(pageId) {
                // Hide all pages
                pages.forEach(page => page.classList.add('hidden'));
                // Show the requested page
                document.getElementById(`${pageId}-page`).classList.remove('hidden');

                // Update active state of bottom nav buttons
                document.querySelectorAll('.nav-btn').forEach(btn => {
                    if (btn.getAttribute('data-page') === pageId) {
                        btn.classList.add('text-teal-600');
                    } else {
                        btn.classList.remove('text-teal-600');
                    }
                });

                // Close drawer if it's open
                sideDrawer.classList.remove('open');
                drawerOverlay.classList.remove('visible');

                // Re-render content for home page if needed
                if (pageId === 'home') {
                    renderFeatures();
                    renderPlaces();
                    renderPackages();
                    renderQuickActions();
                } else if (pageId === 'explore') {
                    renderExploreCategories();
                }
            }
            
            navButtons.forEach(button => {
                button.addEventListener('click', (e) => {
                    const pageId = e.currentTarget.getAttribute('data-page');
                    if (pageId === 'profile') {
                        showProfileModal();
                    } else {
                        showPage(pageId);
                    }
                });
            });

            // --- Initial Render ---
            renderCarousel();
            renderFeatures();
            renderPlaces();
            renderPackages();
            renderQuickActions();
            showPage('home'); // Ensure home page is shown on load
        });
    </script>
